{
  "name": "zipcodetw-demo",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "copy-data": "bun scripts/copy_data.ts",
    "build": "bun run copy-data && bun build ./src/index.ts --outdir ./public",
    "start": "bunx serve ./public",
    "dev": "bun run copy-data && bun build ./src/index.ts --outdir ./public --watch"
  },
  "dependencies": {
    "zipcodetw": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
